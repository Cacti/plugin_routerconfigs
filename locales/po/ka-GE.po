#: includes/arrays.php router-accounts.php
msgid "Username"
msgstr "მომხმარებლის სახელი"

#: includes/arrays.php
msgid "The username that will be used for authentication."
msgstr "მომხმარებლის სახელი, რომელიც გამოიყენება ავთენტიფიკაციისთვის."

#: includes/arrays.php
msgid "Password"
msgstr "პაროლი"

#: includes/arrays.php
msgid "The password used for authentication."
msgstr "პაროლი ავთენტიკაციისთვის."

#: includes/arrays.php
msgid "Enable Password"
msgstr "პაროლის ჩართვა"

#: includes/arrays.php
msgid "Your Enable Password, if required."
msgstr "თქვენი Enable-ის პაროლი, თუ საჭიროა."

#: includes/arrays.php
msgid "Enable Device"
msgstr "მოწყობილობის ჩართვა"

#: includes/arrays.php
msgid "Uncheck this box to disabled this device from being backed up."
msgstr "მოხსენით მონიშვნა ამ ველს, რათა გამორთოთ ამ მოწყობილობის სარეზერვო ასლის შექმნა."

#: includes/arrays.php router-accounts.php
msgid "Description"
msgstr "აღწერა"

#: includes/arrays.php
msgid "Name of this device (will be used for config saving and SVN if no hostname is present in config)."
msgstr "ამ მოწყობილობის სახელი (გამოიყენება კონფიგურაციის შენახვისა და SVN-ისთვის, თუ კონფიგურაციაში ჰოსტის სახელი მითითებული არ არის)."

#: includes/arrays.php router-devices.php
msgid "IP Address"
msgstr "IP მისამართი"

#: includes/arrays.php
msgid "This is the IP Address used to communicate with the device."
msgstr "ეს არის IP მისამართი, რომელიც გამოიყენება მოწყობილობასთან კომუნიკაციისთვის."

#: includes/arrays.php router-devices.php
msgid "TFTP Server"
msgstr "TFTP სერვერი"

#: includes/arrays.php
msgid "Optional TFTP server this device copies its configuration to. Leave blank to use the global TFTP Server setting."
msgstr "არასავალდებულო TFTP სერვერი, რომელზეც ეს მოწყობილობა აკოპირებს თავის კონფიგურაციას. დატოვეთ ცარიელი გლობალური TFTP სერვერის პარამეტრის გამოსაყენებლად."

#: includes/arrays.php
msgid "Stored SSH Host Key"
msgstr "შენახული SSH ჰოსტის გასაღები"

#: includes/arrays.php
msgid "Compare this host-key algorithm and SHA-1 hex fingerprint with the device through a trusted channel. On the server, replace the path below with the matching public host-key file and run: awk '{print $2}' /etc/ssh/ssh_host_ed25519_key.pub | base64 -d | openssl dgst -sha1 | awk '{print toupper($NF)}'. Use the device action to clear it after a legitimate key change."
msgstr "შეადარეთ ეს ჰოსტის გასაღების ალგორითმი და SHA-1 თექვსმეტობითი ანაბეჭდი მოწყობილობას სანდო არხით. სერვერზე შეცვალეთ ქვემოთ მოცემული ბილიკი შესაბამისი საჯარო ჰოსტის გასაღების ფაილით და გაუშვით: awk '{print $2}' /etc/ssh/ssh_host_ed25519_key.pub | base64 -d | openssl dgst -sha1 | awk '{print toupper($NF)}'. გასაღების ლეგიტიმური ცვლილების შემდეგ გასასუფთავებლად გამოიყენეთ მოწყობილობის მოქმედება."

#: includes/arrays.php router-backups.php router-devices.php
msgid "Directory"
msgstr "საქაღალდე"

#: includes/arrays.php
msgid "This is the relative directory structure used to store the configs."
msgstr "ეს არის კონფიგურაციების შესანახად გამოყენებული ფარდობითი დირექტორიის სტრუქტურა."

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Schedule Type"
msgstr "გეგმის ტიპი"

#: includes/arrays.php
msgid "How often to Backup this device. Daily with a Rerun Every of 10 performs a backup every 10 days; Monthly performs a true calendar-month backup."
msgstr "რამდენად ხშირად შეიქმნას ამ მოწყობილობის სარეზერვო ასლი. „ყოველდღიური“ „თავიდან გაშვება ყოველ“-ით 10 ასრულებს სარეზერვო ასლს ყოველ 10 დღეში; „ყოველთვიური“ ასრულებს სარეზერვო ასლს კალენდარული თვის მიხედვით."

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Rerun Every"
msgstr "თავიდან გაშვება ყოველ"

#: includes/arrays.php
msgid "For Daily schedules, rerun the backup every X days. For Weekly schedules without specific Days of Week, rerun it every X weeks; once Days of Week are selected the backup runs on those days every week and this field does not apply."
msgstr "„ყოველდღიური“ გეგმებისთვის სარეზერვო ასლი თავიდან გაეშვება ყოველ X დღეში. „ყოველკვირეული“ გეგმებისთვის კონკრეტული „კვირის დღეების“ გარეშე — ყოველ X კვირაში; როგორც კი „კვირის დღეები“ აირჩევა, სარეზერვო ასლი გაეშვება ამ დღეებში ყოველ კვირას და ეს ველი არ გამოიყენება."

#: includes/arrays.php includes/scheduler.php
msgid "Days of Week"
msgstr "კვირის დღეები"

#: includes/arrays.php
msgid "For a Weekly schedule, the day(s) of the week to run the backup on, every week. Leave empty to run every Rerun Every weeks instead."
msgstr "„ყოველკვირეული“ გეგმისთვის კვირის დღე(ებ)ი, როდესაც სარეზერვო ასლი უნდა გაეშვას ყოველ კვირას. დატოვეთ ცარიელი, რათა ნაცვლად გაეშვას ყოველ „თავიდან გაშვება ყოველ“ კვირაში."

#: includes/arrays.php includes/scheduler.php
msgid "Months of Year"
msgstr "წლის თვეები"

#: includes/arrays.php
msgid "For a Monthly schedule, the month(s) of the year to run the backup in."
msgstr "„ყოველთვიური“ გეგმისთვის წლის თვე(ებ)ი, რომლებშიც უნდა გაეშვას სარეზერვო ასლი."

#: includes/arrays.php includes/scheduler.php
msgid "Days of Month"
msgstr "თვის დღეები"

#: includes/arrays.php
msgid "For a Monthly schedule, the day(s) of the month to run the backup on (Last = last day of the month)."
msgstr "„ყოველთვიური“ გეგმისთვის თვის დღე(ებ)ი, როდესაც უნდა გაეშვას სარეზერვო ასლი („ბოლო“ = თვის ბოლო დღე)."

#: includes/arrays.php includes/scheduler.php
msgid "Weeks of Month"
msgstr "თვის კვირები"

#: includes/arrays.php
msgid "For a Monthly on Day schedule, the week(s) of the month to run the backup in."
msgstr "„ყოველთვიურად კონკრეტულ დღეს“ გეგმისთვის თვის კვირა(ებ)ი, რომლებშიც უნდა გაეშვას სარეზერვო ასლი."

#: includes/arrays.php includes/scheduler.php
msgid "Days of Week (Monthly)"
msgstr "კვირის დღეები (ყოველთვიური)"

#: includes/arrays.php
msgid "For a Monthly on Day schedule, the weekday(s) to pair with the Weeks of Month selection."
msgstr "„ყოველთვიურად კონკრეტულ დღეს“ გეგმისთვის კვირის დღე(ებ)ი, რომლებიც დაწყვილდება „თვის კვირების“ არჩევანთან."

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Device Type"
msgstr "მოწყობილობის ტიპი"

#: includes/arrays.php
msgid "Choose the type of device that the router is."
msgstr "აირჩიეთ მოწყობილობის ტიპი, რომელსაც როუტერი წარმოადგენს."

#: includes/arrays.php router-devices.php
msgid "Auto-Detect"
msgstr "ავტოაღმოჩენა"

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Connection Type"
msgstr "კავშირის ტიპი"

#: includes/arrays.php
msgid "This is the type of connection used to communicate with the device."
msgstr "ეს არის კავშირის ტიპი, რომელიც გამოიყენება მოწყობილობასთან კომუნიკაციისთვის."

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Authentication Account"
msgstr "ავთენტიკაციის ანგარიში"

#: includes/arrays.php
msgid "Choose an account to use to Login to the router"
msgstr "აირჩიეთ ანგარიში როუტერში შესასვლელად"

#: includes/arrays.php
msgid "None"
msgstr "არცერთი"

#: includes/arrays.php
msgid "Default timeout"
msgstr "ნაგულისხმევი მოლოდინის ვადა"

#: includes/arrays.php
msgid "Default time to wait in seconds for a response"
msgstr "პასუხის მოლოდინის ნაგულისხმევი დრო წამებში"

#: includes/arrays.php
msgid "Default sleep time"
msgstr "ნაგულისხმევი ძილის დრო"

#: includes/arrays.php
msgid "Default time to sleep in microseconds (1/1,000,000th of a second)"
msgstr "დაყოვნების ნაგულისხმევი დრო მიკროწამებში (წამის 1/1,000,000 ნაწილი)"

#: includes/arrays.php
msgid "Assume elevated"
msgstr "აწევის ჩათვლა"

#: includes/arrays.php
msgid "Check this box to assume this device is always elevated"
msgstr "მონიშნეთ ეს ველი, რათა ჩაითვალოს, რომ ამ მოწყობილობას ყოველთვის აქვს პრივილეგირებული წვდომა"

#: includes/arrays.php
msgid "Name of this device type."
msgstr "ამ მოწყობილობის ტიპის სახელი."

#: includes/arrays.php
msgid "Username Prompt"
msgstr "მომხმარებლის სახელის მოთხოვნა"

#: includes/arrays.php
msgid "This is the username prompt to match on login."
msgstr "ეს არის მომხმარებლის სახელის მოთხოვნა, რომელიც უნდა დაემთხვეს შესვლისას."

#: includes/arrays.php
msgid "Password Prompt"
msgstr "პაროლის მოთხოვნა"

#: includes/arrays.php
msgid "This is the password prompt to match on login."
msgstr "ეს არის პაროლის მოთხოვნა, რომელიც უნდა დაემთხვეს შესვლისას."

#: includes/arrays.php
msgid "Configuration file"
msgstr "კონფიგურაციის ფაილი"

#: includes/arrays.php
msgid "This is the standard location of the configuration file on the remote device. It is used for SCP and SFTP method"
msgstr "ეს არის კონფიგურაციის ფაილის სტანდარტული მდებარეობა დაშორებულ მოწყობილობაზე. გამოიყენება SCP და SFTP მეთოდებისთვის"

#: includes/arrays.php router-devtypes.php
msgid "Copy TFTP"
msgstr "TFTP-ის კოპირება"

#: includes/arrays.php
msgid "This is the CLI text used to send the backup to tftp server."
msgstr "ეს არის CLI ტექსტი, რომელიც გამოიყენება სარეზერვო ასლის tftp სერვერზე გასაგზავნად."

#: includes/arrays.php
msgid "Capture Command"
msgstr "ამოღების ბრძანება"

#: includes/arrays.php
msgid "Optional command whose output is saved as the configuration, instead of copying it to a TFTP server. It always runs over SSH, whatever the Connection Type, and the device then needs no TFTP server. Leave blank for devices that copy their configuration to TFTP. Example for MikroTik RouterOS: /export"
msgstr "არასავალდებულო ბრძანება, რომლის გამომავალი შედეგიც ინახება კონფიგურაციის სახით, TFTP სერვერზე კოპირების ნაცვლად. ის ყოველთვის ეშვება SSH-ით, კავშირის ტიპის მიუხედავად, და მოწყობილობას აღარ სჭირდება TFTP სერვერი. დატოვეთ ცარიელი იმ მოწყობილობებისთვის, რომლებიც კონფიგურაციას TFTP-ზე აკოპირებენ. მაგალითი MikroTik RouterOS-ისთვის: /export"

#: includes/arrays.php
msgid "Show Version"
msgstr "ვერსიის ჩვენება"

#: includes/arrays.php
msgid "This is the CLI text used to display the current version."
msgstr "ეს არის CLI ტექსტი, რომელიც გამოიყენება მიმდინარე ვერსიის საჩვენებლად."

#: includes/arrays.php
msgid "Confirmation Prompt"
