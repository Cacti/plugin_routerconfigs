msgstr "გზა, სადაც დაარქივდება თქვენი კონფიგურაციები (გადატანილი TFTP დირექტორიიდან)"

#: includes/arrays.php
msgid "Email Options"
msgstr "ელფოსტის მორგება"

#: includes/arrays.php
msgid "From Address"
msgstr "მისამართიდან"

#: includes/arrays.php
