msgstr "Olu luhlobo loqhagamshelwano olusetyenziselwa ukunxibelelana nesixhobo."

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Authentication Account"
msgstr "I-Akhawunti yoQinisekiso"

#: includes/arrays.php
msgid "Choose an account to use to Login to the router"
msgstr "Khetha i-akhawunti oza kuyisebenzisa ukuNgena kwirawutha"

#: includes/arrays.php
msgid "None"
msgstr "Akukho"

#: includes/arrays.php
msgid "Default timeout"
msgstr "Ixesha lokuphelelwa elingagqibekanga"

#: includes/arrays.php
msgid "Default time to wait in seconds for a response"
msgstr "Ixesha elingagqibekanga lokulinda impendulo ngemizuzwana"

#: includes/arrays.php
