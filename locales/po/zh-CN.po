msgid "Name"
msgstr "名称"

#: includes/arrays.php
msgid "Give this account a meaningful name that will be displayed."
msgstr "为此帐户提供一个有意义的名称，以便显示。"

#: includes/arrays.php router-accounts.php
msgid "Username"
msgstr "用户名"

#: includes/arrays.php
msgid "The username that will be used for authentication."
msgstr "将用于身份验证的用户名。"

#: includes/arrays.php
msgid "Password"
msgstr "密码"

#: includes/arrays.php
