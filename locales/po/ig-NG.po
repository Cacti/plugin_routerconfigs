#: includes/arrays.php router-devtypes.php
msgid "Name"
msgstr "Aha"

#: includes/arrays.php
msgid "Give this account a meaningful name that will be displayed."
msgstr "Nye akaụntụ a aha nwere nghọta a ga-egosipụta."

#: includes/arrays.php router-accounts.php
msgid "Username"
msgstr "Aha njirimara"

#: includes/arrays.php
msgid "The username that will be used for authentication."
msgstr "Aha njirimara a ga-eji maka nkwenye njirimara."

#: includes/arrays.php
msgid "Password"
msgstr "Okwuntụghe"

#: includes/arrays.php
msgid "The password used for authentication."
msgstr "Okwuntụghe e ji eme nkwenye njirimara."

#: includes/arrays.php
msgid "Enable Password"
msgstr "Gbanye Okwuntụghe"

#: includes/arrays.php
msgid "Your Enable Password, if required."
msgstr "Okwuntụghe Enable gị, ma ọ bụrụ na achọrọ ya."

#: includes/arrays.php
msgid "Enable Device"
msgstr "Gbanye Ngwaọrụ"

#: includes/arrays.php
msgid "Uncheck this box to disabled this device from being backed up."
msgstr "Wepụ akara n'igbe a iji gbanyụọ ngwaọrụ a ka a ghara idowe nkwado ya."

#: includes/arrays.php router-accounts.php
msgid "Description"
msgstr "Nkọwa"

#: includes/arrays.php
msgid "Name of this device (will be used for config saving and SVN if no hostname is present in config)."
msgstr "Aha ngwaọrụ a (a ga-eji ya chekwaa nhazi na SVN ma ọ bụrụ na enweghị aha onye nnabata na nhazi)."

#: includes/arrays.php router-devices.php
msgid "IP Address"
msgstr "Adreesị IP"

#: includes/arrays.php
msgid "This is the IP Address used to communicate with the device."
msgstr "Nke a bụ Adreesị IP eji ezirịta ozi na ngwaọrụ ahụ."

#: includes/arrays.php router-devices.php
msgid "TFTP Server"
msgstr "Sava TFTP"

#: includes/arrays.php
msgid "Optional TFTP server this device copies its configuration to. Leave blank to use the global TFTP Server setting."
msgstr "Sava TFTP nhọrọ ebe ngwaọrụ a na-edepụtagasị nhazi ya. Hapụ ya n'efu iji ntọala Sava TFTP zuru ụwa ọnụ."

#: includes/arrays.php
msgid "Stored SSH Host Key"
msgstr "Igodo Onye nnabata SSH Echekwara"

#: includes/arrays.php
msgid "Compare this host-key algorithm and SHA-1 hex fingerprint with the device through a trusted channel. On the server, replace the path below with the matching public host-key file and run: awk '{print $2}' /etc/ssh/ssh_host_ed25519_key.pub | base64 -d | openssl dgst -sha1 | awk '{print toupper($NF)}'. Use the device action to clear it after a legitimate key change."
msgstr "Tụnyere algọridim igodo onye nnabata a na akara mkpịsị aka hex SHA-1 na ngwaọrụ ahụ site na ọwa a tụkwasịrị obi. Na sava ahụ, dochie ụzọ dị n'okpuru na faịlụ igodo onye nnabata ọha dabara adaba ma gbaa: awk '{print $2}' /etc/ssh/ssh_host_ed25519_key.pub | base64 -d | openssl dgst -sha1 | awk '{print toupper($NF)}'. Jiri omume ngwaọrụ kpochapụ ya mgbe emechara mgbanwe igodo ziri ezi."

#: includes/arrays.php router-backups.php router-devices.php
msgid "Directory"
msgstr "Ndekọ faịlụ"

#: includes/arrays.php
msgid "This is the relative directory structure used to store the configs."
msgstr "Nke a bụ usoro ndekọ nwere mmekọrịta e ji echekwa nhazi."

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Schedule Type"
msgstr "Ụdị Nhazi Oge"

#: includes/arrays.php
msgid "How often to Backup this device. Daily with a Rerun Every of 10 performs a backup every 10 days; Monthly performs a true calendar-month backup."
msgstr "Ugboro ole a ga-echekwa nkwado (Backup) nke Ngwaọrụ a. Kwa ụbọchị nwere Megharịa Kwa 10 na-eme nkwado kwa ụbọchị 10; Kwa ọnwa na-eme nkwado ezigbo ọnwa kalenda."

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Rerun Every"
msgstr "Megharịa Kwa"

#: includes/arrays.php
msgid "For Daily schedules, rerun the backup every X days. For Weekly schedules without specific Days of Week, rerun it every X weeks; once Days of Week are selected the backup runs on those days every week and this field does not apply."
msgstr "Maka nhazi oge Kwa Ụbọchị, mee nkwado ndabere ọzọ kwa ụbọchị X. Maka nhazi oge Kwa Izu na-enweghị Ụbọchị Izu akọwapụtara, mee ya ọzọ kwa izu X; ozugbo ahọpụtara Ụbọchị Izu, nkwado ndabere ga na-agba n'ụbọchị ndị ahụ kwa izu na ubi a agaghị emetụta."

#: includes/arrays.php includes/scheduler.php
msgid "Days of Week"
msgstr "Ụbọchị nke Izu"

#: includes/arrays.php
msgid "For a Weekly schedule, the day(s) of the week to run the backup on, every week. Leave empty to run every Rerun Every weeks instead."
msgstr "Maka nhazi oge Kwa Izu, ụbọchị nke izu a ga-eme nkwado ndabere, kwa izu. Hapụ ya n'efu ka ọ gbaa kwa izu Mee Ọzọ Kwa kama."

#: includes/arrays.php includes/scheduler.php
msgid "Months of Year"
msgstr "Ọnwa nke Afọ"

#: includes/arrays.php
msgid "For a Monthly schedule, the month(s) of the year to run the backup in."
msgstr "Maka nhazi oge Kwa Ọnwa, ọnwa nke afọ a ga-eme nkwado ndabere."

#: includes/arrays.php includes/scheduler.php
msgid "Days of Month"
msgstr "Ụbọchị nke Ọnwa"

#: includes/arrays.php
msgid "For a Monthly schedule, the day(s) of the month to run the backup on (Last = last day of the month)."
msgstr "Maka nhazi oge Kwa Ọnwa, ụbọchị nke ọnwa a ga-eme nkwado ndabere (Ikpeazụ = ụbọchị ikpeazụ nke ọnwa)."

#: includes/arrays.php includes/scheduler.php
msgid "Weeks of Month"
msgstr "Izu nke Ọnwa"

#: includes/arrays.php
msgid "For a Monthly on Day schedule, the week(s) of the month to run the backup in."
msgstr "Maka nhazi oge Kwa Ọnwa n'Ụbọchị, izu nke ọnwa a ga-eme nkwado ndabere."

#: includes/arrays.php includes/scheduler.php
msgid "Days of Week (Monthly)"
msgstr "Ụbọchị nke Izu (Kwa Ọnwa)"

#: includes/arrays.php
msgid "For a Monthly on Day schedule, the weekday(s) to pair with the Weeks of Month selection."
msgstr "Maka nhazi oge Kwa Ọnwa n'Ụbọchị, ụbọchị izu a ga-ejikọta na nhọrọ Izu nke Ọnwa."

