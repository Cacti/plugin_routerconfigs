msgstr "Họrọ akaụntụ ị ga-eji banye na rụta"

#: includes/arrays.php
msgid "None"
msgstr "Ọ Dịghị Nke Ọ Bụla"

#: includes/arrays.php
msgid "Default timeout"
msgstr "Oge njedebe nke ndabara"

#: includes/arrays.php
