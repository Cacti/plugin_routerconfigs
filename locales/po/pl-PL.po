msgid "No devices were changed: the new schedule cannot run on device id(s) %s, because their Months, Days of Month, Weeks of Month or Days of Week are missing or never occur. Set the schedule on those devices individually."
msgstr "Nie zmieniono żadnych urządzeń: nowy harmonogram nie może zostać uruchomiony na urządzeniach o ID %s, ponieważ brakuje w nich miesięcy, dni miesiąca, tygodni miesiąca lub dni tygodnia albo nigdy one nie występują. Ustaw harmonogram dla tych urządzeń indywidualnie."

#: router-devices.php
#, php-format
msgid "Updated settings on %d device(s)."
msgstr "Zaktualizowano ustawienia na %d urządzeniu(-ach)."

#: router-devices.php
msgid "No settings were changed; every field was left on \"No Change\"."
msgstr "Nie zmieniono żadnych ustawień; każde pole pozostało ustawione na \"Bez zmian\"."

#: router-devices.php
#, php-format
msgid "DEBUG: Executing manual backup using '%s' with arguments '%s'"
msgstr "DEBUG: Wykonywanie ręcznej kopii zapasowej przy użyciu '%s' z argumentami '%s'"

#: router-devices.php
msgid "Router Backup started.  Check the Date Backup column or the Cacti Log for completion status and timing"
msgstr "Rozpoczęto tworzenie kopii zapasowej routera. Sprawdź kolumnę Data kopii zapasowej lub dziennik Cacti, aby poznać stan i czas zakończenia"

#: router-devices.php
msgid "Click 'Continue' to Delete the following device(s)."
msgstr "Kliknij „Kontynuuj”, aby usunąć następujące urządzenia."

#: router-devices.php
msgid "Click 'Continue' to Enable the following device(s)."
msgstr "Kliknij „Kontynuuj”, aby włączyć następujące urządzenia."

#: router-devices.php
msgid "Enable Device(s)"
msgstr "Włączyć urządzenie(-a)"

#: router-devices.php
msgid "Click 'Continue' to Disable the following device(s)."
msgstr "Kliknij „Kontynuuj”, aby wyłączyć następujące urządzenia."

#: router-devices.php
msgid "Disable Device(s)"
msgstr "Urządzenie(-a) wyłączane"

#: router-devices.php
msgid "Click 'Continue' to clear the stored SSH host key for the following device(s). The next SSH connection will trust and record the key it receives."
msgstr "Kliknij „Kontynuuj”, aby wyczyścić zapisany klucz hosta SSH dla następujących urządzeń. Następne połączenie SSH zaufa otrzymanemu kluczowi i go zapisze."

#: router-devices.php
msgid "Clear SSH Host Key(s)"
msgstr "Wyczyść klucze hosta SSH"

#: router-devices.php
msgid "Set one or more of the following settings on the selected device(s). Fields left on 'No Change' are not modified."
msgstr "Skonfiguruj jedno lub więcej z poniższych ustawień na wybranych urządzeniach. Pola pozostawione jako 'Bez zmian' nie są modyfikowane."

