msgstr "Wybierz typ urządzenia dla tego routera."

#: includes/arrays.php router-devices.php
msgid "Auto-Detect"
msgstr "Wykryj automatycznie"

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Connection Type"
msgstr "Typ połączenia"

#: includes/arrays.php
msgid "This is the type of connection used to communicate with the device."
msgstr "Jest to typ połączenia używanego do komunikacji z urządzeniem."

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Authentication Account"
msgstr "Konto uwierzytelniania"

#: includes/arrays.php
msgid "Choose an account to use to Login to the router"
msgstr "Wybierz konto do logowania na routerze"

#: includes/arrays.php
msgid "None"
msgstr "Brak"

#: includes/arrays.php
msgid "Default timeout"
msgstr "Domyślny limit czasu"

#: includes/arrays.php
msgid "Default time to wait in seconds for a response"
msgstr "Domyślny czas oczekiwania na odpowiedź w sekundach"

#: includes/arrays.php
msgid "Default sleep time"
msgstr "Domyślny czas uśpienia"

#: includes/arrays.php
