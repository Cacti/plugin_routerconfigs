#: includes/arrays.php router-accounts.php
msgid "Username"
msgstr "የተጠቃሚ ስም"

#: includes/arrays.php
msgid "The username that will be used for authentication."
msgstr "ለማረጋገጫ የሚያገለግለው የተጠቃሚ ስም።"

#: includes/arrays.php
msgid "Password"
msgstr "የይለፍ ቃል"

#: includes/arrays.php
msgid "The password used for authentication."
msgstr "ለማረጋገጫ ጥቅም ላይ የዋለው የይለፍ ቃል።"

#: includes/arrays.php
msgid "Enable Password"
msgstr "Enable የይለፍ ቃል"

#: includes/arrays.php
msgid "Your Enable Password, if required."
msgstr "የእርስዎ Enable የይለፍ ቃል፣ አስፈላጊ ከሆነ።"

#: includes/arrays.php
msgid "Enable Device"
msgstr "መሣሪያን አንቃ"

#: includes/arrays.php
msgid "Uncheck this box to disabled this device from being backed up."
msgstr "ይህ መሣሪያ ምትኬ እንዳይወሰድበት ለማሰናከል የዚህን ሳጥን ምልክት ያንሱ።"

#: includes/arrays.php router-accounts.php
msgid "Description"
msgstr "መግለጫ"

#: includes/arrays.php
msgid "Name of this device (will be used for config saving and SVN if no hostname is present in config)."
msgstr "የዚህ መሣሪያ ስም (በውቅሩ ውስጥ የአስተናጋጅ ስም ከሌለ ውቅርን ለማስቀመጥ እና ለSVN ያገለግላል)።"

#: includes/arrays.php router-devices.php
msgid "IP Address"
msgstr "የIP አድራሻ"

#: includes/arrays.php
msgid "This is the IP Address used to communicate with the device."
msgstr "ይህ ከመሣሪያው ጋር ለመገናኘት የሚያገለግለው የIP አድራሻ ነው።"

#: includes/arrays.php router-devices.php
msgid "TFTP Server"
msgstr "የTFTP አገልጋይ"

#: includes/arrays.php
msgid "Optional TFTP server this device copies its configuration to. Leave blank to use the global TFTP Server setting."
msgstr "ይህ መሣሪያ ውቅሩን የሚቀዳበት አማራጭ TFTP አገልጋይ። ዓለም አቀፋዊውን የTFTP አገልጋይ ቅንብር ለመጠቀም ባዶ ይተዉት።"

#: includes/arrays.php
msgid "Stored SSH Host Key"
msgstr "የተከማቸ የSSH አስተናጋጅ ቁልፍ"

#: includes/arrays.php
msgid "Compare this host-key algorithm and SHA-1 hex fingerprint with the device through a trusted channel. On the server, replace the path below with the matching public host-key file and run: awk '{print $2}' /etc/ssh/ssh_host_ed25519_key.pub | base64 -d | openssl dgst -sha1 | awk '{print toupper($NF)}'. Use the device action to clear it after a legitimate key change."
msgstr "ይህን የአስተናጋጅ-ቁልፍ ስልተ-ቀመር እና የSHA-1 ሄክስ አሻራ ከመሣሪያው ጋር በታመነ ቻናል አወዳድር። በአገልጋዩ ላይ ከታች ያለውን መንገድ በተዛማጅ የህዝብ አስተናጋጅ-ቁልፍ ፋይል ተክተው ይህን ያሂዱ፦ awk '{print $2}' /etc/ssh/ssh_host_ed25519_key.pub | base64 -d | openssl dgst -sha1 | awk '{print toupper($NF)}'። ህጋዊ የቁልፍ ለውጥ ከተደረገ በኋላ እሱን ለማጽዳት የመሣሪያ እርምጃውን ይጠቀሙ።"

#: includes/arrays.php router-backups.php router-devices.php
msgid "Directory"
msgstr "ማውጫ"

#: includes/arrays.php
msgid "This is the relative directory structure used to store the configs."
msgstr "ይህ ውቅሮችን ለማከማቸት የሚያገለግለው አንጻራዊ የማውጫ መዋቅር ነው።"

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Schedule Type"
msgstr "የመርሃግብር ዓይነት"

#: includes/arrays.php
msgid "How often to Backup this device. Daily with a Rerun Every of 10 performs a backup every 10 days; Monthly performs a true calendar-month backup."
msgstr "ይህን መሣሪያ ምን ያህል ጊዜ ምትኬ (Backup) ማስቀመጥ እንደሚያስፈልግ። «በየቀኑ» ከ«በየ 10 ቀኑ ድገም» ጋር በየ10 ቀኑ ምትኬ ይፈጽማል፤ «በየወሩ» ትክክለኛ የቀን መቁጠሪያ ወር ምትኬን ይፈጽማል።"

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Rerun Every"
msgstr "እንደገና አሂድ በየ"

#: includes/arrays.php
msgid "For Daily schedules, rerun the backup every X days. For Weekly schedules without specific Days of Week, rerun it every X weeks; once Days of Week are selected the backup runs on those days every week and this field does not apply."
msgstr "ለዕለታዊ መርሃ ግብሮች፣ ምትኬውን በየ X ቀናት እንደገና ያሂዱ። የተወሰኑ የሳምንቱ ቀናት ለሌላቸው ሳምንታዊ መርሃ ግብሮች፣ በየ X ሳምንታት እንደገና ያሂዱት፤ የሳምንቱ ቀናት ከተመረጡ በኋላ ምትኬው በየሳምንቱ በእነዚያ ቀናት ይሄዳል እና ይህ መስክ አይተገበርም።"

#: includes/arrays.php includes/scheduler.php
msgid "Days of Week"
msgstr "የሳምንቱ ቀናት"

#: includes/arrays.php
msgid "For a Weekly schedule, the day(s) of the week to run the backup on, every week. Leave empty to run every Rerun Every weeks instead."
msgstr "ለሳምንታዊ መርሃ ግብር፣ ምትኬው በየሳምንቱ የሚሄድበት የሳምንቱ ቀን(ኖች)። በምትኩ በየ 'በየዚህን ያህል ጊዜ እንደገና አሂድ' ሳምንታት እንዲሄድ ባዶ ይተዉት።"

#: includes/arrays.php includes/scheduler.php
msgid "Months of Year"
msgstr "የዓመቱ ወራት"

#: includes/arrays.php
msgid "For a Monthly schedule, the month(s) of the year to run the backup in."
msgstr "ለወርሃዊ መርሃ ግብር፣ ምትኬው የሚሄድበት የዓመቱ ወር(ሮች)።"

#: includes/arrays.php includes/scheduler.php
msgid "Days of Month"
msgstr "የወሩ ቀናት"

#: includes/arrays.php
msgid "For a Monthly schedule, the day(s) of the month to run the backup on (Last = last day of the month)."
msgstr "ለወርሃዊ መርሃ ግብር፣ ምትኬው የሚሄድበት የወሩ ቀን(ኖች) (የመጨረሻ = የወሩ የመጨረሻ ቀን)።"

#: includes/arrays.php includes/scheduler.php
msgid "Weeks of Month"
msgstr "የወሩ ሳምንታት"

#: includes/arrays.php
msgid "For a Monthly on Day schedule, the week(s) of the month to run the backup in."
msgstr "ለወርሃዊ በቀን መርሃ ግብር፣ ምትኬው የሚሄድበት የወሩ ሳምንት(ቶች)።"

#: includes/arrays.php includes/scheduler.php
msgid "Days of Week (Monthly)"
msgstr "የሳምንቱ ቀናት (ወርሃዊ)"

#: includes/arrays.php
msgid "For a Monthly on Day schedule, the weekday(s) to pair with the Weeks of Month selection."
msgstr "ለወርሃዊ በቀን መርሃ ግብር፣ ከወሩ ሳምንታት ምርጫ ጋር የሚጣመር የሳምንቱ ቀን(ኖች)።"

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Device Type"
msgstr "የመሣሪያ ዓይነት"

#: includes/arrays.php
msgid "Choose the type of device that the router is."
msgstr "ራውተሩ የሆነውን የመሣሪያ ዓይነት ይምረጡ።"

#: includes/arrays.php router-devices.php
msgid "Auto-Detect"
msgstr "በራስ-ሰር አግኝ"

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Connection Type"
msgstr "የግንኙነት ዓይነት"

#: includes/arrays.php
msgid "This is the type of connection used to communicate with the device."
msgstr "ይህ ከመሣሪያው ጋር ለመገናኘት ጥቅም ላይ የዋለው የግንኙነት ዓይነት ነው።"

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Authentication Account"
msgstr "የማረጋገጫ መለያ"

#: includes/arrays.php
msgid "Choose an account to use to Login to the router"
msgstr "ወደ ራውተሩ ለመግባት የሚጠቀሙበትን መለያ ይምረጡ"

#: includes/arrays.php
msgid "None"
msgstr "ምንም"

#: includes/arrays.php
msgid "Default timeout"
msgstr "ነባሪ የጊዜ ማብቂያ"

#: includes/arrays.php
msgid "Default time to wait in seconds for a response"
msgstr "ምላሽ ለመጠበቅ በሰከንዶች ውስጥ ነባሪ የመቆያ ጊዜ"

#: includes/arrays.php
msgid "Default sleep time"
msgstr "ነባሪ የእንቅልፍ ጊዜ"

#: includes/arrays.php
msgid "Default time to sleep in microseconds (1/1,000,000th of a second)"
msgstr "በማይክሮሰከንዶች ውስጥ የሚቆይበት ነባሪ የእንቅልፍ ጊዜ (ከአንድ ሰከንድ 1/1,000,000ኛ)"

#: includes/arrays.php
msgid "Assume elevated"
msgstr "ከፍ ያለ መብት እንዳለ ይገመት"

#: includes/arrays.php
msgid "Check this box to assume this device is always elevated"
msgstr "ይህ መሣሪያ ሁልጊዜ ከፍ ያለ ፈቃድ እንዳለው ለመገመት ይህን ሳጥን ይምረጡ"

#: includes/arrays.php
msgid "Name of this device type."
msgstr "የዚህ የመሣሪያ ዓይነት ስም።"

#: includes/arrays.php
msgid "Username Prompt"
msgstr "የተጠቃሚ ስም መጠየቂያ"

#: includes/arrays.php
msgid "This is the username prompt to match on login."
msgstr "ይህ በመግቢያ ላይ የሚዛመድ የተጠቃሚ ስም መጠየቂያ ነው።"

#: includes/arrays.php
msgid "Password Prompt"
msgstr "የይለፍ ቃል መጠየቂያ"

