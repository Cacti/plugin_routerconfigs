#: includes/arrays.php router-accounts.php
msgid "Username"
msgstr "Kullanıcı Adı"

#: includes/arrays.php
msgid "The username that will be used for authentication."
msgstr "Kimlik doğrulama için kullanılacak kullanıcı adı."

#: includes/arrays.php
msgid "Password"
msgstr "Şifre"

#: includes/arrays.php
