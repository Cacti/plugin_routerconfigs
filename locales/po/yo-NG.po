#: includes/arrays.php router-devtypes.php
msgid "Copy TFTP"
msgstr "Ṣe àdàkọ TFTP"

#: includes/arrays.php
msgid "This is the CLI text used to send the backup to tftp server."
msgstr "Èyí ni ọ̀rọ̀ CLI tí a lò láti fi àtìlẹ́yìn-àpamọ́ ránṣẹ́ sí olùpèsè tftp."

#: includes/arrays.php
msgid "Capture Command"
msgstr "Àṣẹ Ìgbàmú"

#: includes/arrays.php
msgid "Optional command whose output is saved as the configuration, instead of copying it to a TFTP server. It always runs over SSH, whatever the Connection Type, and the device then needs no TFTP server. Leave blank for devices that copy their configuration to TFTP. Example for MikroTik RouterOS: /export"
msgstr "Àṣẹ àṣàyàn tí a máa ń fi èsì rẹ̀ pamọ́ gẹ́gẹ́ bí ètò, dípò dídà á sí orí olùpèsè TFTP. Ó máa ń ṣiṣẹ́ lórí SSH nígbà gbogbo, láìka Irú Ìsopọ̀ sí, nígbà náà ẹ̀rọ náà kò nílò olùpèsè TFTP kankan. Fi sílẹ̀ ní òfo fún àwọn ẹ̀rọ tí ó ń da ètò wọn sí TFTP. Àpẹẹrẹ fún MikroTik RouterOS: /export"

#: includes/arrays.php
msgid "Show Version"
msgstr "Ṣàfihàn Ẹ̀yà"

#: includes/arrays.php
