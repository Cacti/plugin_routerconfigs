msgstr "זמן השהיה ברירת מחדל"

#: includes/arrays.php
msgid "Default time to sleep in microseconds (1/1,000,000th of a second)"
msgstr "זמן השהיה ברירת מחדל במיקרו-שניות (1/1,000,000 של שנייה)"

#: includes/arrays.php
msgid "Assume elevated"
msgstr "הנח מצב מורשה (elevated)"

#: includes/arrays.php
msgid "Check this box to assume this device is always elevated"
msgstr "סמן תיבה זו כדי להניח שהתקן זה נמצא תמיד בהרשאה מוגברת (elevated)"

#: includes/arrays.php
msgid "Name of this device type."
msgstr "שם סוג התקן זה."

#: includes/arrays.php
msgid "Username Prompt"
msgstr "בקשת שם משתמש"

#: includes/arrays.php
msgid "This is the username prompt to match on login."
msgstr "זוהי בקשת שם המשתמש שיש להתאים בעת ההתחברות."

#: includes/arrays.php
msgid "Password Prompt"
msgstr "בקשת סיסמה"

#: includes/arrays.php
msgid "This is the password prompt to match on login."
msgstr "זוהי בקשת הסיסמה שיש להתאים בעת ההתחברות."

#: includes/arrays.php
msgid "Configuration file"
msgstr "קובץ תצורה"

#: includes/arrays.php
msgid "This is the standard location of the configuration file on the remote device. It is used for SCP and SFTP method"
msgstr "זהו המיקום הסטנדרטי של קובץ התצורה בהתקן המרוחק. הוא משמש עבור שיטת SCP ו-SFTP"

#: includes/arrays.php router-devtypes.php
msgid "Copy TFTP"
msgstr "העתקת TFTP"

#: includes/arrays.php
msgid "This is the CLI text used to send the backup to tftp server."
msgstr "זהו טקסט ה-CLI המשמש לשליחת הגיבוי לשרת TFTP."

#: includes/arrays.php
msgid "Capture Command"
msgstr "פקודת לכידה"

#: includes/arrays.php
msgid "Optional command whose output is saved as the configuration, instead of copying it to a TFTP server. It always runs over SSH, whatever the Connection Type, and the device then needs no TFTP server. Leave blank for devices that copy their configuration to TFTP. Example for MikroTik RouterOS: /export"
msgstr "פקודה אופציונלית שפלטה נשמר כתצורה, במקום להעתיק אותה לשרת TFTP. היא רצה תמיד דרך SSH, ללא קשר לסוג החיבור, ואז ההתקן אינו זקוק לשרת TFTP. השאר ריק עבור התקנים המעתיקים את תצורתם ל-TFTP. דוגמה עבור MikroTik RouterOS: /export"

#: includes/arrays.php
msgid "Show Version"
msgstr "הצג גרסה"

#: includes/arrays.php
msgid "This is the CLI text used to display the current version."
msgstr "זהו טקסט ה-CLI המשמש להצגת הגרסה הנוכחית."

#: includes/arrays.php
msgid "Confirmation Prompt"
msgstr "הנחיית אישור"

#: includes/arrays.php
msgid "This is the confirmation prompt to match before transmission."
msgstr "זוהי הנחיית האישור שיש להתאים לפני השידור."

#: includes/arrays.php router-devtypes.php
msgid "Confirm"
msgstr "אשר"

#: includes/arrays.php
msgid "Is there a confirmation prompt for copying the config?"
msgstr "האם מוצגת בקשת אישור בעת העתקת התצורה?"

#: includes/arrays.php router-devtypes.php
msgid "Force Confirm"
msgstr "אלץ אישור"

#: includes/arrays.php
msgid "Is there a force confirmation prompt for copying the config?"
msgstr "האם קיימת בקשת אישור מאולץ בעת העתקת התצורה?"

#: includes/arrays.php
msgid "Check End in Config"
msgstr "בדיקת End בתצורה"

#: includes/arrays.php
msgid "Check end in config?"
msgstr "האם לבדוק end בתצורה?"

#: includes/arrays.php
msgid "Any Key prompt"
msgstr "בקשת לחיצה על מקש כלשהו"

#: includes/arrays.php
msgid "Text to match a 'Press Any Key To Continue' styled prompt"
msgstr "טקסט להתאמה להנחיה בסגנון 'Press Any Key To Continue'"

#: includes/arrays.php
msgid "Post-Login Prompts"
msgstr "הנחיות לאחר התחברות"

#: includes/arrays.php
msgid "Optional prompt/response pairs sent right after login, before the copy-to-TFTP command, one per line as prompt|response. The prompt is matched as a case-insensitive regular expression against the device output (so it cannot itself contain |, and brackets and other special characters must be escaped, e.g. Save \\[y/n\\]), and the response is sent as typed, or use <CR> to send just a carriage return. A response is only sent once its prompt has been seen, either in the reply to the previous response or in later output; otherwise a warning is logged and nothing is sent. These are answered first; the Any Key prompt above is answered later, while the device is being enabled, so a prompt answered here never reaches Any Key. Example: Press any key|<CR>"
msgstr "זוגות הנחיה/תגובה אופציונליים הנשלחים מיד לאחר ההתחברות, לפני פקודת ההעתקה ל-TFTP, זוג אחד בשורה בתבנית prompt|response. ההנחיה מותאמת כביטוי רגולרי לא תלוי-רישיות מול פלט ההתקן (לכן היא אינה יכולה להכיל בעצמה |, ויש לבצע escape לסוגריים ולתווים מיוחדים אחרים, למשל Save \\[y/n\\]), והתגובה נשלחת כפי שהוקלדה, או השתמש ב-<CR> כדי לשלוח מעבר שורה (carriage return) בלבד. תגובה נשלחת רק לאחר שהנחייתה זוהתה, בתשובה לתגובה הקודמת או בפלט מאוחר יותר; אחרת תירשם אזהרה ביומן ולא יישלח דבר. על אלה נענה תחילה; על הנחיית Any Key למעלה נענה מאוחר יותר, בעת הפעלת ההתקן, כך שהנחיה שנענתה כאן לעולם אינה מגיעה ל-Any Key. דוגמה: Press any key|<CR>"

#: includes/arrays.php
msgid "General Settings"
msgstr "הגדרות כלליות"

#: includes/arrays.php
msgid "Presentation Mode"
msgstr "מצב תצוגה"

#: includes/arrays.php
msgid "Should Router Configs be presented on the Console or a Top Tab."
msgstr "האם להציג את Router Configs במסוף (Console) או בלשונית עליונה."

#: includes/arrays.php
msgid "Console"
msgstr "מסוף"

#: includes/arrays.php
msgid "Top Tab"
msgstr "הכרטיסייה העליונה"

#: includes/arrays.php
msgid "Config Diff Context Lines"
msgstr "שורות הקשר להשוואת תצורה"

#: includes/arrays.php
msgid "The default number of unchanged lines to display before and after each change when comparing two backups. A larger value makes it easier to see the surrounding configuration context. This may be overridden per comparison on the Compare page."
msgstr "מספר ברירת המחדל של שורות ללא שינוי להצגה לפני ואחרי כל שינוי בעת השוואת שני גיבויים. ערך גדול יותר מקל על ראיית הקשר התצורה שמסביב. ניתן לעקוף הגדרה זו לכל השוואה בדף ההשוואה."

#: includes/arrays.php
#| msgid "Connection Type"
msgid "Connection timeout"
msgstr "זמן קצוב לחיבור"

#: includes/arrays.php
msgid "Maximum time to wait in seconds when establishing the initial network connection to a device. A hung or unreachable device is abandoned after this timeout so a scheduled backup run continues with the remaining devices."
msgstr "זמן ההמתנה המרבי בשניות בעת יצירת חיבור הרשת הראשוני להתקן. התקן תקוע או שאינו נגיש ננטש לאחר פרק זמן זה כדי שהרצת גיבוי מתוזמנת תמשיך עם שאר ההתקנים."

#: includes/arrays.php
msgid "Close without exit"
msgstr "סגור ללא יציאה"

#: includes/arrays.php
msgid "If ticked, when closing down the device connection, no 'exit' command is issued"
msgstr "אם מסומן, בעת סגירת החיבור להתקן לא תישלח פקודת 'exit'"

#: includes/arrays.php
msgid "Debug Connection Buffer"
msgstr "חוצץ ניפוי שגיאות חיבור"

#: includes/arrays.php
msgid "Whether to log direct output of device connection"
msgstr "האם לתעד ביומן פלט ישיר של חיבור ההתקן"

#: includes/arrays.php
msgid "Assume all devices elevated"
msgstr "הנח שכל ההתקנים במצב מורשה (elevated)"

#: includes/arrays.php
msgid "Whether to assume all devices are elevated"
msgstr "האם להניח שכל ההתקנים נמצאים במצב הרשאות מוגברות (elevated)"

#: includes/arrays.php
msgid "Download Hour"
msgstr "שעת הורדה"

