#: includes/arrays.php includes/functions.php router-devices.php
#| msgid "Schedule"
msgid "Schedule Type"
msgstr "סוג לוח זמנים"

#: includes/arrays.php
msgid "How often to Backup this device. Daily with a Rerun Every of 10 performs a backup every 10 days; Monthly performs a true calendar-month backup."
msgstr "באיזו תדירות לגבות התקן זה. תדירות יומית עם ערך \"הרץ מחדש כל\" של 10 מבצעת גיבוי כל 10 ימים; תדירות חודשית מבצעת גיבוי לפי חודש קלנדרי אמיתי."

#: includes/arrays.php includes/functions.php router-devices.php
msgid "Rerun Every"
msgstr "Rerun כל"

#: includes/arrays.php
msgid "For Daily schedules, rerun the backup every X days. For Weekly schedules without specific Days of Week, rerun it every X weeks; once Days of Week are selected the backup runs on those days every week and this field does not apply."
msgstr "עבור תזמונים יומיים, הרץ מחדש את הגיבוי כל X ימים. עבור תזמונים שבועיים ללא ימים ספציפיים בשבוע, הרץ אותו מחדש כל X שבועות; לאחר שנבחרו ימים בשבוע הגיבוי רץ באותם ימים מדי שבוע ושדה זה אינו חל."

#: includes/arrays.php includes/scheduler.php
msgid "Days of Week"
msgstr "ימים בשבוע"

#: includes/arrays.php
msgid "For a Weekly schedule, the day(s) of the week to run the backup on, every week. Leave empty to run every Rerun Every weeks instead."
msgstr "עבור תזמון שבועי, יום(י) השבוע שבהם יורץ הגיבוי מדי שבוע. השאר ריק כדי להריץ כל מספר השבועות שבשדה \"הרץ מחדש כל\"."

#: includes/arrays.php includes/scheduler.php
msgid "Months of Year"
msgstr "חודשים של שנה"

#: includes/arrays.php
msgid "For a Monthly schedule, the month(s) of the year to run the backup in."
msgstr "עבור תזמון חודשי, החודש(ים) בשנה שבהם יורץ הגיבוי."

#: includes/arrays.php includes/scheduler.php
#| msgid "This Month"
msgid "Days of Month"
msgstr "ימים בחודש"

#: includes/arrays.php
msgid "For a Monthly schedule, the day(s) of the month to run the backup on (Last = last day of the month)."
msgstr "עבור תזמון חודשי, יום(י) החודש שבהם יורץ הגיבוי (אחרון = היום האחרון בחודש)."

#: includes/arrays.php includes/scheduler.php
msgid "Weeks of Month"
msgstr "שבועות בחודש"

#: includes/arrays.php
msgid "For a Monthly on Day schedule, the week(s) of the month to run the backup in."
msgstr "עבור תזמון חודשי לפי יום, השבוע(ות) בחודש שבהם יורץ הגיבוי."

#: includes/arrays.php includes/scheduler.php
msgid "Days of Week (Monthly)"
msgstr "ימי השבוע (חודשי)"

#: includes/arrays.php
msgid "For a Monthly on Day schedule, the weekday(s) to pair with the Weeks of Month selection."
msgstr "עבור תזמון חודשי לפי יום, יום(י) השבוע שיש לשייך לבחירת השבועות בחודש."

