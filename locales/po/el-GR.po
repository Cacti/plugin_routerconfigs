#: includes/arrays.php router-accounts.php
msgid "Username"
msgstr "Όνομα Χρήστη"

#: includes/arrays.php
msgid "The username that will be used for authentication."
msgstr "Το όνομα χρήστη που θα χρησιμοποιηθεί για έλεγχο ταυτότητας."

#: includes/arrays.php
msgid "Password"
msgstr "Κωδικός"

#: includes/arrays.php
